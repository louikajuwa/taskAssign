APP_NAME=TaskAssign
APP_ENV=local
APP_KEY=
# APP_DEBUG must be false (and APP_ENV=production) in production.
APP_DEBUG=true
APP_URL=http://localhost:8087

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=taskassign
DB_USERNAME=taskassign
DB_PASSWORD=secret
# Optional: separate MySQL root password (fresh volumes only). Defaults to DB_PASSWORD.
# DB_ROOT_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
# Set true to encrypt session payloads at rest (sessions are stored in the database).
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

SENDGRID_API_KEY=your-sendgrid-api-key-here
SENDGRID_FROM_EMAIL=noreply@yourdomain.com
SENDGRID_FROM_NAME=TaskAssign

ADMIN_EMAIL=admin@example.com
# Set a strong password before seeding (migrate --seed).
ADMIN_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
